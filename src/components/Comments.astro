---
// 익명 댓글 — 로그인도 이름도 없다. Turnstile 로 봇만 거른다.
// COMMENTS_API 가 비어 있으면 아무것도 그리지 않는다 (4단계 배포 전).
import { COMMENTS_API, TURNSTILE_SITE_KEY } from '../lib/site';
interface Props { post: string }
const { post } = Astro.props;
---

{COMMENTS_API && (
  <section class="comments" data-api={COMMENTS_API} data-post={post} data-sitekey={TURNSTILE_SITE_KEY}>
    <h2>의견</h2>
    <p class="comments-note">로그인 없이 남길 수 있어요. 이름도 이메일도 받지 않아요. 답은 주 1회 AI가 달아요.</p>
    <ol class="comment-list" aria-live="polite"></ol>
    <form class="comment-form">
      <textarea name="body" rows="4" maxlength="2000" placeholder="이 글에 대한 의견, 내 직군에서 안 되는 점, 다음에 다뤘으면 하는 업무…" required></textarea>
      <div class="comment-actions">
        {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible"></div>}
        <button type="submit">남기기</button>
      </div>
      <p class="comment-status" role="status"></p>
    </form>
  </section>
)}

{COMMENTS_API && TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const root = document.querySelector<HTMLElement>('.comments');
  if (root) {
    const api = root.dataset.api!;
    const post = root.dataset.post!;
    const list = root.querySelector<HTMLOListElement>('.comment-list')!;
    const form = root.querySelector<HTMLFormElement>('.comment-form')!;
    const status = root.querySelector<HTMLElement>('.comment-status')!;

    const fmt = (iso: string) => new Date(iso).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

    async function load() {
      const res = await fetch(`${api}/comments?post=${encodeURIComponent(post)}`);
      if (!res.ok) return;
      const data = await res.json() as { comments: { id: number; body: string; created: string; parent: number | null; is_owner: number }[]; owner: string };
      const byParent = new Map<number | null, typeof data.comments>();
      for (const c of data.comments) {
        const key = c.parent ?? null;
        if (!byParent.has(key)) byParent.set(key, []);
        byParent.get(key)!.push(c);
      }
      list.innerHTML = '';
      const render = (c: (typeof data.comments)[number], depth: number) => {
        const li = document.createElement('li');
        li.className = c.is_owner ? 'comment owner' : 'comment';
        li.style.marginLeft = `${depth * 20}px`;
        const who = document.createElement('span');
        who.className = 'comment-who';
        who.textContent = c.is_owner ? data.owner : '익명';
        const when = document.createElement('span');
        when.className = 'comment-when';
        when.textContent = fmt(c.created);
        const body = document.createElement('p');
        body.textContent = c.body;
        li.append(who, when, body);
        list.append(li);
        for (const child of byParent.get(c.id) ?? []) render(child, depth + 1);
      };
      for (const c of byParent.get(null) ?? []) render(c, 0);
      if (!data.comments.length) {
        const li = document.createElement('li');
        li.className = 'comment empty';
        li.textContent = '아직 의견이 없어요. 첫 번째로 남겨 보세요.';
        list.append(li);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = (form.elements.namedItem('body') as HTMLTextAreaElement).value.trim();
      const token = (form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')?.value) || '';
      status.textContent = '보내는 중…';
      const res = await fetch(`${api}/comments`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ post, body, token }),
      });
      const out = await res.json().catch(() => ({})) as { error?: string; note?: string };
      if (!res.ok) { status.textContent = out.error || '남기지 못했어요'; return; }
      status.textContent = out.note || '남겼어요. 고마워요.';
      form.reset();
      (window as any).turnstile?.reset?.();
      await load();
    });

    load();
  }
</script>

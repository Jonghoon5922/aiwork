---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SITE_NAME, SITE_TAGLINE, url, VERIFY_NAVER, VERIFY_GOOGLE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}
const { title, description, type = 'website', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og-default.png', Astro.site);
const desc = description ?? SITE_TAGLINE;
const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
const current = (prefix: string) => (path === prefix || path.startsWith(prefix + '/') ? 'page' : undefined);

// 메뉴는 글이 있는 주제만 보여 준다. 빈 방은 보여 주지 않는다.
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const posts = await getCollection('posts', ({ data }) => !data.draft);
const navTopics = topics.filter((t) => posts.some((p) => p.data.topic === t.id));
// 주제 페이지(와 그 글)는 그 주제의 색으로 물든다. 프로젝트 페이지는 made 색.
const seg = path.split('/').filter(Boolean)[0] ?? '';
const pageTopic = topics.find((t) => t.id === seg) ?? (seg === 'projects' ? topics.find((t) => t.id === 'made') : undefined);
const bodyClass = pageTopic ? `theme-${pageTopic.data.color}` : 'theme-home';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: Astro.site?.toString(),
  description: SITE_TAGLINE,
  inLanguage: 'ko',
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title === SITE_NAME ? title : `${title} · ${SITE_NAME}`}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={url('/rss.xml')} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {VERIFY_NAVER && <meta name="naver-site-verification" content={VERIFY_NAVER} />}
    {VERIFY_GOOGLE && <meta name="google-site-verification" content={VERIFY_GOOGLE} />}
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}><span class="brand-mark"></span>{SITE_NAME}</a>
        <nav class="nav">
          {navTopics.map((t) => (
            <a href={url(`/${t.id}`)} aria-current={current(`/${t.id}`)} class={`c-${t.data.color}`}>{t.data.icon && <span class="nav-icon">{t.data.icon}</span>}{t.data.name}</a>
          ))}
          <a href={url('/about')} aria-current={current('/about')}>소개</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>{SITE_TAGLINE}. 로그인 없이 읽고, 그대로 가져가고, 의견을 남겨요.</span>
        <nav>
          <a href={url('/about')}>소개</a>
          <a href={url('/rss.xml')}>RSS</a>
          <a href={url('/llms.txt')}>llms.txt</a>
          <a href="https://github.com/Jonghoon5922/aiwork">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

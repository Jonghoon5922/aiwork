---
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE, url, VERIFY_NAVER, VERIFY_GOOGLE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}
const { title, description, type = 'website', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og-default.png', Astro.site);
const desc = description ?? SITE_TAGLINE;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: Astro.site?.toString(),
  description: SITE_TAGLINE,
  inLanguage: 'ko',
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title === SITE_NAME ? title : `${title} · ${SITE_NAME}`}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={url('/rss.xml')} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {VERIFY_NAVER && <meta name="naver-site-verification" content={VERIFY_NAVER} />}
    {VERIFY_GOOGLE && <meta name="google-site-verification" content={VERIFY_GOOGLE} />}
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{SITE_NAME}</a>
        <nav class="nav">
          <a href={url('/ai-biseo')}>AI 업무 비서</a>
          <a href={url('/made')}>만든 것들</a>
          <a href={url('/how-this-runs')}>운영 방식</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        {SITE_TAGLINE}. 로그인 없이 읽고, 그대로 가져가고, 의견을 남겨요.
      </div>
    </footer>
  </body>
</html>

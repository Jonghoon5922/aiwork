---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Comments from '../../components/Comments.astro';
import CopyScript from '../../components/CopyScript.astro';
import { url, fmtDate, KIND_LABEL, byline } from '../../lib/site';
import { STAGES } from '../../content.config';

// 글 파일은 src/content/posts/<topic>/<slug>.md 에 둔다. id 가 "topic/slug" 가 되어 그대로 주소가 된다.
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => {
    const [topic, ...rest] = post.id.split('/');
    return { params: { topic, slug: rest.join('/') }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const topics = await getCollection('topics');
const topic = topics.find((t) => t.id === post.data.topic);

// 같은 주제의 글들 — 이전·다음(연재는 order, 나머지는 날짜)과 관련 글
const siblings = (await getCollection('posts', ({ data }) => !data.draft && data.topic === post.data.topic));
const ordered =
  post.data.kind === 'workbook' || post.data.kind === 'journal'
    ? siblings.filter((p) => p.data.kind === post.data.kind && p.data.series === post.data.series).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    : post.data.project
      ? siblings.filter((p) => p.data.project === post.data.project).sort((a, b) => {
          const si = (k: string) => { const i = (STAGES as readonly string[]).indexOf(k); return i < 0 ? STAGES.length : i; };
          return si(a.data.kind) - si(b.data.kind) || a.data.date.valueOf() - b.data.date.valueOf();
        })
      : siblings.filter((p) => p.data.kind !== 'workbook' && p.data.kind !== 'journal').sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const idx = ordered.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;
const related = siblings.filter((p) => p.id !== post.id).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  inLanguage: 'ko',
  author: { '@type': 'Person', name: 'Jonghoon' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
const faq =
  post.data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.data.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<Base title={post.data.title} description={post.data.summary} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
  {faq && <script type="application/ld+json" set:html={JSON.stringify(faq)} />}

  <article>
    <div class="meta" style="margin:0 0 10px">
      <a href={url(`/${post.data.topic}`)}>{topic?.data.name ?? post.data.topic}</a>
      <span class="dot"></span>
      <span>{KIND_LABEL[post.data.kind]}</span>
      {post.data.audience && <><span class="dot"></span><span>{post.data.audience}</span></>}
      {post.data.project && <><span class="dot"></span><a href={url(`/projects/${post.data.project}`)}>{post.data.project}</a></>}
      {post.data.series && post.data.order && <><span class="dot"></span><span>{post.data.series} {post.data.order}편</span></>}
    </div>
    <h1>{post.data.title}</h1>
    {post.data.question && <p class="question">{post.data.question}</p>}
    <div class="meta" style="margin:0 0 28px"><span>{fmtDate(post.data.date)}</span></div>

    <div class="prose">
      <Content />
    </div>

    {post.data.faq.length > 0 && (
      <section class="faq">
        <h2>자주 묻는 것</h2>
        {post.data.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    {topic?.data.notice && <p class="notice">{topic.data.notice}</p>}
    <p class="byline">{byline(post.data.materials)}</p>

    {(prev || next) && (
      <nav class="pager" aria-label="이전·다음 글">
        {prev ? <a href={url(`/${prev.id}`)}><span class="label">이전</span>{prev.data.title}</a> : <span></span>}
        {next ? <a class="next" href={url(`/${next.id}`)}><span class="label">다음</span>{next.data.title}</a> : <span></span>}
      </nav>
    )}
  </article>

  <Comments post={post.id} />
  <CopyScript />

  {related.length > 0 && (
    <section class="related">
      <div class="section-head"><h2>같은 주제의 다른 글</h2><a href={url(`/${post.data.topic}`)}>전부 보기</a></div>
      <PostList posts={related} />
    </section>
  )}
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CopyScript from '../../components/CopyScript.astro';
import { PROJECT_TYPES, PROJECT_TYPE_LABEL, STAGES, STAGE_LABEL, STAGE_QUESTION } from '../../content.config';
import { url, fmtDate } from '../../lib/site';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.topic === topic.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const SERIAL = ['workbook', 'journal', 'digest'];
const series = posts
  .filter((p) => SERIAL.includes(p.data.kind))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
// 만드는 과정 — 이 주제에 속한 프로젝트의 개발 주기 글(분석→…→운영). "만든 것들" 은 카드로 보여 주므로 제외.
const stageIndex = (k: string) => { const i = (STAGES as readonly string[]).indexOf(k); return i < 0 ? STAGES.length : i; };
const making = topic.id === 'made' ? [] : posts
  .filter((p) => (STAGES as readonly string[]).includes(p.data.kind))
  .sort((a, b) => stageIndex(a.data.kind) - stageIndex(b.data.kind) || a.data.date.valueOf() - b.data.date.valueOf());
const makingIds = new Set(making.map((p) => p.id));
const others = posts.filter((p) => !SERIAL.includes(p.data.kind) && !makingIds.has(p.id));
const audiences = [...new Set(others.map((p) => p.data.audience).filter(Boolean))] as string[];
const madeStages = new Set(making.map((p) => p.data.kind));
const nextStage = STAGES.find((s) => !madeStages.has(s));
// 이 주제에 연결된 프로젝트(카드의 topic 이 이 주제)가 있으면 글이 없어도 만드는 과정 진행표를 보여 준다.
const linkedProjects = topic.id === 'made' ? [] : (await getCollection('projects')).filter((p) => p.data.topic === topic.id);

// "만든 것들" 은 종류별 섹션으로 카드를 보여 준다.
const projects = topic.id === 'made'
  ? (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
  : [];
const nameOf = (slug?: string) => projects.find((p) => p.id === slug)?.data.name;
const allPosts = topic.id === 'made' ? await getCollection('posts', ({ data }) => !data.draft) : [];
const postCountOf = (slug: string) => allPosts.filter((p) => p.data.project === slug).length;
const sections = PROJECT_TYPES
  .map((type) => ({ type, label: PROJECT_TYPE_LABEL[type], items: projects.filter((p) => p.data.type === type) }))
  .filter((s) => s.items.length > 0);
---

<Base title={topic.data.name} description={topic.data.summary}>
  <h1>{topic.data.name}</h1>
  <p class="lede">{topic.data.summary}</p>
  <div class="prose"><Content /></div>

  {sections.map((s) => (
    <>
      <div class="section-head"><h2>{s.label}</h2><span>{s.items.length}개</span></div>
      <ul class="cards">
        {s.items.map((p) => (
          <ProjectCard project={p} parentName={nameOf(p.data.parent)} postCount={postCountOf(p.id)} />
        ))}
      </ul>
    </>
  ))}

  {topic.data.chapters.length > 0 && (
    <>
      <div class="section-head"><h2>차례</h2><span>하루 한 장, 순서대로</span></div>
      <ol class="series toc">
        {topic.data.chapters.map((title, i) => {
          const post = series.find((p) => p.data.order === i + 1);
          return post ? (
            <li>
              <a class="post-row" href={url(`/${post.id}`)}>
                <span>
                  <span class="title">{post.data.title}</span>
                  <p class="summary">{post.data.summary}</p>
                </span>
              </a>
            </li>
          ) : (
            <li>
              <div class="post-row pending">
                <span>
                  <span class="title">{title}</span>
                  <p class="summary">준비 중이에요. 저자 경험담이 채워지면 올라와요.</p>
                </span>
              </div>
            </li>
          );
        })}
      </ol>
    </>
  )}

  {topic.data.chapters.length === 0 && series.length > 0 && (
    <>
      <div class="section-head"><h2>{series[0].data.series ?? '연재'}</h2><span>순서대로 읽어요</span></div>
      <ol class="series">
        {series.map((post) => (
          <li>
            <a class="post-row" href={url(`/${post.id}`)}>
              <span>
                <span class="title">{post.data.title}</span>
                <p class="summary">{post.data.summary}</p>
                <div class="meta"><span>{fmtDate(post.data.date)}</span></div>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </>
  )}

  {(others.length > 0 || (series.length === 0 && topic.data.chapters.length === 0)) && (
    <div class="section-head"><h2>{topic.id === 'ai-at-work' ? '직군별 사례' : '글'}</h2>{topic.id === 'ai-at-work' && <span>같은 절차를 실제 업무에 적용한 예</span>}</div>
  )}
  {others.length === 0 && series.length === 0 && topic.data.chapters.length === 0 ? (
    <p class="empty">아직 글이 없어요. 주 1회 올라와요.</p>
  ) : others.length === 0 ? null : (
    <>
      {audiences.length > 1 && (
        <div class="chips" role="group" aria-label="직군 필터">
          <button class="chip" aria-pressed="true" data-audience="">전체</button>
          {audiences.map((a) => <button class="chip" aria-pressed="false" data-audience={a}>{a}</button>)}
        </div>
      )}
      <PostList posts={others} filterable />
    </>
  )}
  {topic.id !== 'made' && (making.length > 0 || linkedProjects.length > 0) && (
    <>
      <div class="section-head"><h2>이 가이드는 이렇게 만들었어요</h2><span>왜 만들고, 어떻게 만들고, 돌려 보니 어떤가</span></div>
      <ol class="stepper" aria-label="만드는 과정">
        {STAGES.map((s) => (
          <li class={madeStages.has(s) ? 'done' : s === nextStage ? 'current' : ''}>
            <span class="step-label">{STAGE_LABEL[s]}</span>
            <span class="step-q">{STAGE_QUESTION[s]}</span>
            <span class="step-count">{making.filter((p) => p.data.kind === s).length ? `${making.filter((p) => p.data.kind === s).length}편` : ''}</span>
          </li>
        ))}
      </ol>
      {making.length === 0 ? (
        <p class="empty">만드는 과정 글은 곧 올라와요. 분석(왜 만들었나)부터예요.</p>
      ) : (
        <ol class="series">
          {making.map((post) => (
            <li>
              <a class="post-row" href={url(`/${post.id}`)}>
                <span>
                  <span class="title">{post.data.title}</span>
                  <p class="summary">{post.data.summary}</p>
                  <div class="meta"><span class="badge on">{STAGE_LABEL[post.data.kind as keyof typeof STAGE_LABEL]}</span><span>{fmtDate(post.data.date)}</span></div>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </>
  )}

  <CopyScript />
</Base>

<script>
  // 직군 칩 필터 — 서버에서 다 그려 두고 숨기기만 한다. JS 가 없어도 전체가 보인다.
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const rows = document.querySelectorAll<HTMLLIElement>('.posts li[data-audience]');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const pick = chip.dataset.audience ?? '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    rows.forEach((li) => { li.hidden = pick !== '' && li.dataset.audience !== pick; });
  }));
</script>

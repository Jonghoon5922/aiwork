---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CopyScript from '../../components/CopyScript.astro';
import { PROJECT_TYPES, PROJECT_TYPE_LABEL } from '../../content.config';
import { url, fmtDate } from '../../lib/site';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.topic === topic.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const series = posts
  .filter((p) => p.data.kind === 'workbook' || p.data.kind === 'journal')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const others = posts.filter((p) => p.data.kind !== 'workbook' && p.data.kind !== 'journal');
const audiences = [...new Set(others.map((p) => p.data.audience).filter(Boolean))] as string[];

// "만든 것들" 은 종류별 섹션으로 카드를 보여 준다.
const projects = topic.id === 'made'
  ? (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
  : [];
const nameOf = (slug?: string) => projects.find((p) => p.id === slug)?.data.name;
const allPosts = topic.id === 'made' ? await getCollection('posts', ({ data }) => !data.draft) : [];
const postCountOf = (slug: string) => allPosts.filter((p) => p.data.project === slug).length;
const sections = PROJECT_TYPES
  .map((type) => ({ type, label: PROJECT_TYPE_LABEL[type], items: projects.filter((p) => p.data.type === type) }))
  .filter((s) => s.items.length > 0);
---

<Base title={topic.data.name} description={topic.data.summary}>
  <h1>{topic.data.name}</h1>
  <p class="lede">{topic.data.summary}</p>
  <div class="prose"><Content /></div>

  {sections.map((s) => (
    <>
      <div class="section-head"><h2>{s.label}</h2><span>{s.items.length}개</span></div>
      <ul class="cards">
        {s.items.map((p) => (
          <ProjectCard project={p} parentName={nameOf(p.data.parent)} postCount={postCountOf(p.id)} />
        ))}
      </ul>
    </>
  ))}

  {series.length > 0 && (
    <>
      <div class="section-head"><h2>{series[0].data.series ?? '연재'}</h2><span>순서대로 읽어요</span></div>
      <ol class="series">
        {series.map((post) => (
          <li>
            <a class="post-row" href={url(`/${post.id}`)}>
              <span>
                <span class="title">{post.data.title}</span>
                <p class="summary">{post.data.summary}</p>
                <div class="meta"><span>{fmtDate(post.data.date)}</span></div>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </>
  )}

  {(others.length > 0 || series.length === 0) && (
    <div class="section-head"><h2>{topic.id === 'ai-biseo' ? '직군별 사례' : '글'}</h2></div>
  )}
  {others.length === 0 && series.length === 0 ? (
    <p class="empty">아직 글이 없어요. 주 1회 올라와요.</p>
  ) : others.length === 0 ? null : (
    <>
      {audiences.length > 1 && (
        <div class="chips" role="group" aria-label="직군 필터">
          <button class="chip" aria-pressed="true" data-audience="">전체</button>
          {audiences.map((a) => <button class="chip" aria-pressed="false" data-audience={a}>{a}</button>)}
        </div>
      )}
      <PostList posts={others} filterable />
    </>
  )}
  <CopyScript />
</Base>

<script>
  // 직군 칩 필터 — 서버에서 다 그려 두고 숨기기만 한다. JS 가 없어도 전체가 보인다.
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const rows = document.querySelectorAll<HTMLLIElement>('.posts li[data-audience]');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const pick = chip.dataset.audience ?? '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    rows.forEach((li) => { li.hidden = pick !== '' && li.dataset.audience !== pick; });
  }));
</script>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE_NAME, SITE_TAGLINE, url } from '../lib/site';

const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const countBy = (id: string) => allPosts.filter((p) => p.data.topic === id).length;
// 입구는 글이 있는 주제만. 빈 방은 보여 주지 않는다.
const entrances = topics.filter((t) => countBy(t.id) > 0);
const recent = allPosts.slice(0, 8);
const topicName = (id: string) => topics.find((t) => t.id === id)?.data.name ?? id;
---

<Base title={SITE_NAME} description={SITE_TAGLINE}>
  <section class="hero">
    <h1><span class="grad">AI하고 일하고,</span><br /><span class="grad2">AI하고 만들어요</span></h1>
    <p>
      직군이 무엇이든 AI를 내 일에 끌어다 쓰는 법, 그리고 AI와 직접 만든 것들의 기록이에요.
      프롬프트와 설치 명령은 그대로 복사해서 쓰면 돼요. 글은 Claude가 쓰고 검사를 거쳐 자동으로 올라와요.
    </p>
  </section>

  <ul class="entrances">
    {entrances.map((t) => (
      <li>
        <a class={`entrance c-${t.data.color}`} href={url(`/${t.id}`)}>
          <span class="icon" aria-hidden="true">{t.data.icon ?? '●'}</span>
          {t.data.audience && <span class="who">{t.data.audience}</span>}
          <span class="name">{t.data.name} →</span>
          <span class="what">{t.data.summary}</span>
          <span class="count">글 {countBy(t.id)}편</span>
        </a>
      </li>
    ))}
    <li>
      <a class="entrance muted c-blue" href={url('/glossary')}>
        <span class="icon" aria-hidden="true">📖</span>
        <span class="who">글에 나온 말이 낯설면</span>
        <span class="name">용어집 →</span>
        <span class="what">정의 한 줄, 비유 하나, 내 업무에서 어디서 만나는지. 글마다 아래에 "이 글의 용어"가 붙어요.</span>
      </a>
    </li>
    <li>
      <a class="entrance muted c-amber" href={url('/about')}>
        <span class="icon" aria-hidden="true">🤖</span>
        <span class="who">이 사이트가 궁금하면</span>
        <span class="name">소개 →</span>
        <span class="what">글은 Claude가 쓰고, 검사를 거쳐 자동으로 게시돼요. 사람은 경험담을 채우고 가끔 글을 내려요.</span>
      </a>
    </li>
  </ul>

  <div class="section-head">
    <h2>최근 글</h2>
    <a href={url('/rss.xml')}>RSS로 받기</a>
  </div>
  {recent.length === 0 ? (
    <p class="empty">아직 글이 없어요. 첫 글은 곧 올라와요.</p>
  ) : (
    <PostList posts={recent} showTopic topicName={topicName} />
  )}
</Base>

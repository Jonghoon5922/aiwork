---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CopyScript from '../../components/CopyScript.astro';
import { PROJECT_TYPE_LABEL, STAGES, STAGE_LABEL, STAGE_QUESTION } from '../../content.config';
import { url, fmtDate, KIND_LABEL } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const all = await getCollection('projects');
const parent = d.parent ? all.find((p) => p.id === d.parent) : undefined;
const children = all.filter((p) => p.data.parent === project.id).sort((a, b) => a.data.order - b.data.order);
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
// 연재는 개발 주기 순서로 읽는다: 분석 → 설계 → 개발 → 테스트 → 배포 → 운영. 같은 단계 안에서는 오래된 순.
const stageIndex = (k: string) => { const i = (STAGES as readonly string[]).indexOf(k); return i < 0 ? STAGES.length : i; };
const posts = allPosts
  .filter((p) => p.data.project === project.id)
  .sort((a, b) => stageIndex(a.data.kind) - stageIndex(b.data.kind) || a.data.date.valueOf() - b.data.date.valueOf());
const done = new Set(posts.map((p) => p.data.kind));
const currentStage = STAGES.find((s) => !done.has(s));
const postCountOf = (slug: string) => allPosts.filter((p) => p.data.project === slug).length;
---

<Base title={d.name} description={d.summary}>
  <div class="meta" style="margin:0 0 10px">
    <a href={url('/made')}>만든 것들</a>
    {parent && <><span class="dot"></span><a href={url(`/projects/${parent.id}`)}>{parent.data.name}</a></>}
  </div>
  <h1>{d.name}</h1>
  <p class="lede">{d.summary}</p>
  <div class="badges" style="margin-bottom:18px">
    <span class="badge on">{PROJECT_TYPE_LABEL[d.type]}</span>
    <span class="badge">{d.status}</span>
    {d.stack.map((s) => <span class="badge">{s}</span>)}
    {d.url && <a class="badge" href={d.url}>{d.url.replace(/^https?:\/\//, '')} ↗</a>}
    {d.repo && <a class="badge" href={d.repo}>저장소 ↗</a>}
  </div>
  {d.usage && (
    <div class="usage big">
      <span class="label">어떻게 쓰나</span>
      <code>{d.usage}</code>
      <button type="button" class="copy-btn inline" data-copy={d.usage}>복사</button>
    </div>
  )}
  <div class="prose"><Content /></div>

  {children.length > 0 && (
    <>
      <div class="section-head"><h2>함께 가는 것</h2></div>
      <ul class="cards">
        {children.map((c) => <ProjectCard project={c} parentName={d.name} postCount={postCountOf(c.id)} />)}
      </ul>
    </>
  )}

  <div class="section-head"><h2>개발 주기</h2><span>왜 만들고, 어떻게 만들고, 돌려 보니 어떤가</span></div>
  <ol class="stepper" aria-label="개발 주기 진행">
    {STAGES.map((s) => (
      <li class={done.has(s) ? 'done' : s === currentStage ? 'current' : ''}>
        <span class="step-label">{STAGE_LABEL[s]}</span>
        <span class="step-q">{STAGE_QUESTION[s]}</span>
        <span class="step-count">{posts.filter((p) => p.data.kind === s).length ? `${posts.filter((p) => p.data.kind === s).length}편` : ''}</span>
      </li>
    ))}
  </ol>

  <div class="section-head"><h2>연재</h2>{posts.length > 0 && <span>{posts.length}편</span>}</div>
  {posts.length === 0 ? (
    <p class="empty">
      아직 글이 없어요. 첫 글은 분석 글이에요.{parent && <> 지금은 <a href={url(`/projects/${parent.id}`)}>{parent.data.name}</a>의 연재에 함께 다뤄요.</>}
    </p>
  ) : (
    <ol class="series">
      {posts.map((post) => (
        <li>
          <a class="post-row" href={url(`/${post.id}`)}>
            <span>
              <span class="title">{post.data.title}</span>
              <p class="summary">{post.data.summary}</p>
              <div class="meta"><span class="badge on">{KIND_LABEL[post.data.kind]}</span><span>{fmtDate(post.data.date)}</span></div>
            </span>
          </a>
        </li>
      ))}
    </ol>
  )}
  <CopyScript />
</Base>
